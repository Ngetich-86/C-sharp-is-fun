{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Backend.Data.DatabaseContext": "Information"
    }
  },
  "MongoDbSettings": {
    "ConnectionString": "SET_VIA_ENV: MongoDbSettings__ConnectionString",
    "DatabaseName": "SocialMediaDb",
    "UsersCollectionName": "users"
  },
  "JwtSettings": {
    "Secret": "SET_VIA_ENV: JwtSettings__Secret",
    "ResetTokenSecret": "SET_VIA_ENV: JwtSettings__ResetTokenSecret",
    "ExpiryInDays": 7
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:5001"
      }
    }
  }
}
